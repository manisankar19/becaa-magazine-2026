---
layout: layouts/print.njk
title: BECAA Maharashtra Magazine 2026 Print Preview
permalink: /print/
---
<section class="print-cover">
  <img src="../{{ publication.cover.asset }}" alt="একই শিকড় — official BECAA Maharashtra Magazine 2026 cover">
</section>
<section class="print-contents">
  <h1><span lang="bn">একই শিকড়</span> — Contents</h1>
  <ol>{% for item in publication.items | byOrder %}{% if item.print_include %}<li>{{ item.title }} <span>{{ item.id }}</span></li>{% endif %}{% endfor %}</ol>
  {% if publication.sponsor_acknowledgement_message %}<p>Sponsor Acknowledgements / With Thanks</p>{% endif %}
</section>
<section class="print-page print-contact" id="print-contact">
  <p class="section-kicker">Information and Contact</p>
  <h1>Connect with BECAA Maharashtra</h1>
  <p>{{ officialLinks.organisation.full_name }}</p>
  <div class="print-link-grid">
  {% for link in officialLinks.connect %}<article><img src="../assets/normalized/qr/{{ link.id }}.svg" alt="QR code for {{ link.label }}"><div><strong>{{ link.label }}</strong><a href="{{ link.url }}">{{ link.display_text }}</a></div></article>{% endfor %}
  {% for link in officialLinks.cultural_programmes %}<article><img src="../assets/normalized/qr/{{ link.id }}.svg" alt="QR code for {{ link.label }}"><div><strong>{{ link.label }}</strong><a href="{{ link.url }}">{{ link.url }}</a></div></article>{% endfor %}
  </div>
</section>
{% for item in publication.items | byOrder %}
  {% if item.print_include %}
  {% set adStyle = item | adPageStyle if item.type == "advertisement" else "" %}
  {% set kickerLabel = "Advertisements · In memoriam" if (item.type == "advertisement" and item.presentation == "memorial") else (item.section | sectionLabel) %}
  <section class="print-page print-page--{{ item.type }}{% if item.type == "advertisement" %} {{ item | adInkClass }}{% endif %}" id="print-{{ item.id }}" data-testid="print-page-{{ item.id }}"{% if adStyle %} style="{{ adStyle }}"{% endif %}>
    <p class="section-kicker">{{ kickerLabel }} · {{ item.id }}</p>
    <h1>{{ item.title }}</h1>
    {% if item.contributor and item.type != "advertisement" %}<p class="byline">{{ item | byline }}</p>{% endif %}
    {% if item.type == "advertisement" and item.presentation == "text" %}
      <p class="ad-text" data-testid="ad-text-{{ item.id }}">{{ item.text_lines[0] }}</p>
    {% elif item.type == "advertisement" and item.presentation == "memorial" %}
      {% if item.print_asset %}<figure class="ad-frame--memorial"><img class="print-ad" src="../{{ item.print_asset }}" alt="{{ item.alt }}"></figure>{% endif %}
      <div class="ad-memorial" data-testid="ad-memorial-{{ item.id }}">
        {% for line in item.text_lines %}<p{% if loop.index0 == 1 %} class="ad-memorial__name"{% endif %}>{{ line }}</p>{% endfor %}
      </div>
    {% elif item.type == "advertisement" or item.type == "gallery" %}
      {% if item.print_asset %}<figure><img class="print-ad" src="../{{ item.print_asset }}" alt="{{ item.alt }}">{% if item.caption %}<figcaption>{{ item.caption }}{% if item.credit %} — {{ item.credit }}{% endif %}</figcaption>{% endif %}</figure>{% endif %}
    {% else %}
      <div class="prose">
        {{ publicationContent[item.content_file] | markdown | safe }}
      </div>
    {% endif %}
  </section>
  {% endif %}
{% endfor %}
{% if publication.sponsor_acknowledgement_message %}
<section class="print-page print-thanks"><p class="section-kicker">Sponsor Acknowledgements</p><h1>With Thanks</h1><p>{{ publication.sponsor_acknowledgement_message }}</p></section>
{% endif %}

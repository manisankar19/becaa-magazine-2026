# BECAA Magazine 2026 — registration application (Sprint v3).
# Copy to .env.local for local work. NEVER commit .env.local or any real value.
# Production/Preview values live only in Vercel environment variables (see DEPLOYMENT.md).

# PostgreSQL connection strings (local cluster from `npm run db:local:start`, or Neon).
DATABASE_URL=
DATABASE_URL_TEST=

# 32 random bytes, base64: `openssl rand -base64 32`
SESSION_SECRET=
IP_HASH_SALT=

# Single administrator. Hash from `npm run admin:hash` (argon2id); plaintext is never stored.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Emergency switch: "false" makes /api/register return a maintenance notice.
REGISTRATION_ENABLED=true
BATCH_YEAR_MIN=1950
NODE_ENV=development

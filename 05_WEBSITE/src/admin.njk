---
layout: layouts/public.njk
title: Administrator — BECAA Maharashtra Magazine 2026
description: Administrator dashboard for the BECAA Maharashtra 2026 magazine registrations.
permalink: /admin/
pageScript: /assets/js/admin.js
robots: noindex, nofollow
---
{# Sprint v3 Task 31 (PRD §5.5). Static shell only: every number and row is fetched from
   /api/admin/* after a server-side login and inserted with textContent. No inline scripts,
   no inline handlers, no data in the HTML. #}
<section class="admin" aria-labelledby="admin-title">
  <header class="item-header">
    <p class="section-kicker">{{ officialLinks.organisation.name }}</p>
    <h1 id="admin-title">Magazine 2026 — Administrator</h1>
  </header>

  <div class="form-notice" data-testid="admin-notice" role="status" hidden></div>

  <form class="register-form admin-login" data-testid="login-form" autocomplete="off" hidden>
    <div class="field">
      <label for="admin-username">Administrator username</label>
      <input type="text" id="admin-username" name="username" data-testid="username" required maxlength="64" autocomplete="username">
    </div>
    <div class="field">
      <label for="admin-password">Password</label>
      <input type="password" id="admin-password" name="password" data-testid="password" required maxlength="256" autocomplete="current-password">
    </div>
    <p class="field-error" data-testid="login-error" role="alert" hidden></p>
    <button type="submit" class="button" data-testid="login-submit">Sign in</button>
  </form>

  <div class="dashboard" data-testid="dashboard" hidden>
    <div class="dashboard__toolbar">
      <a class="button button--secondary" data-testid="download-csv" href="/api/admin/export.csv">Download CSV</a>
      <button type="button" class="button button--secondary" data-testid="refresh">Refresh</button>
      <button type="button" class="button button--secondary" data-testid="logout">Log out</button>
    </div>

    <section aria-labelledby="totals-title">
      <h2 id="totals-title">Totals</h2>
      <div class="tiles">
        <div class="tile"><span class="tile__label">Registered viewers</span><strong class="tile__value" data-testid="stat-visitors">–</strong></div>
        <div class="tile"><span class="tile__label">Visits</span><strong class="tile__value" data-testid="stat-visits">–</strong></div>
        <div class="tile"><span class="tile__label">Alumni</span><strong class="tile__value" data-testid="stat-alumni">–</strong></div>
        <div class="tile"><span class="tile__label">Sponsors</span><strong class="tile__value" data-testid="stat-sponsor">–</strong></div>
        <div class="tile"><span class="tile__label">Other guests</span><strong class="tile__value" data-testid="stat-guest">–</strong></div>
      </div>
    </section>

    <div class="dashboard__grid">
      <section aria-labelledby="batch-title">
        <h2 id="batch-title">Alumni by batch</h2>
        <table class="data-table bar-table" data-testid="batch-table"><thead><tr><th scope="col">Batch</th><th scope="col">Viewers</th><th scope="col"><span class="visually-hidden">Share</span></th></tr></thead><tbody></tbody></table>
      </section>
      <section aria-labelledby="department-title">
        <h2 id="department-title">Alumni by department</h2>
        <table class="data-table bar-table" data-testid="department-table"><thead><tr><th scope="col">Department</th><th scope="col">Viewers</th><th scope="col"><span class="visually-hidden">Share</span></th></tr></thead><tbody></tbody></table>
      </section>
    </div>

    <section aria-labelledby="registrations-title">
      <h2 id="registrations-title">Registrations</h2>
      <form class="search-form" data-testid="search-form">
        <label for="admin-search">Search name, email or organisation</label>
        <div class="search-row">
          <input type="search" id="admin-search" name="q" data-testid="search" maxlength="120" autocomplete="off">
          <button type="submit" class="button button--secondary" data-testid="search-button">Search</button>
        </div>
      </form>
      <div class="table-scroll">
        <table class="data-table" data-testid="visitors-table">
          <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Category</th><th scope="col">Batch</th><th scope="col">Department</th><th scope="col">Organisation</th><th scope="col">Mobile</th><th scope="col">Registered (IST)</th><th scope="col">Visits</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="pager">
        <button type="button" class="button button--secondary" data-testid="page-prev">Previous</button>
        <span data-testid="page-info"></span>
        <button type="button" class="button button--secondary" data-testid="page-next">Next</button>
      </div>
    </section>
  </div>
</section>

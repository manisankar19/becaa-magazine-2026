    "mammoth": "1.10.0",
    "markdown-it": "14.1.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.54.2",
    "qrcode": "1.5.4",
    "sharp": "0.34.3",
    "xlsx": "0.18.5"
